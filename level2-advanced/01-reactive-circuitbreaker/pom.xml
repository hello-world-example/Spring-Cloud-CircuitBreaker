<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.kai.learn.cbdemo</groupId>
        <artifactId>cbdemo-l2</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>cbdemo-l2-01-reactive-circuitbreaker</artifactId>
    <name>cbdemo :: L2-01 响应式熔断（8201）</name>

    <dependencies>
        <dependency>
            <groupId>com.kai.learn.cbdemo</groupId>
            <artifactId>cbdemo-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <!-- Spring Boot 4 中 WebClient.Builder 的自动配置单独放在这个 starter 中 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webclient</artifactId>
        </dependency>
        <!-- 注意是 reactor- 开头的 starter：额外引入 resilience4j-reactor，提供 Mono/Flux 的操作符 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-circuitbreaker-reactor-resilience4j</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
